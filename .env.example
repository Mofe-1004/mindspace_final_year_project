# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API Environment Variables (Vercel serverless functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# HuggingFace API Configuration
HUGGINGFACE_API_TOKEN=hf_your_token_here

# Bible API Configuration (optional, uses bible-api.com by default)
BIBLE_API_URL=https://bible-api.com

# Anthropic API Key (for AI-powered Bible verse matching with Claude Haiku)
# Optional — falls back to random selection if not configured
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Resend API Key (for email alert notifications)
# Optional — alerts still work in-app without email
RESEND_API_KEY=re_your_key_here

# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Vercel Configuration (auto-set by Vercel)
# VERCEL=1
# VERCEL_URL=your-deployment-url.vercel.app
